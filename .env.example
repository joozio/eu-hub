# EU Hub Environment Variables
# Copy this file to .env.local and fill in your values

# Mistral AI API key - enables AI summaries, personalized brief, and Ask EU chat
# Get yours at https://console.mistral.ai/
# Optional: app works in snapshot/fallback mode without this key
MISTRAL_API_KEY=your_mistral_api_key_here

# Demo mode control: off | hybrid | snapshot
# - off: live data only (requires MISTRAL_API_KEY for AI features)
# - hybrid: try live, fall back to snapshots on failure
# - snapshot: always use cached demo data (no API calls needed)
NEXT_PUBLIC_DEMO_MODE=off
